# ==========================================
# Zepp Life (原小米运动) 自动刷步数环境变量配置文件模板
# 使用方法：复制本文件重命名为 .env，并填入你的实际配置
# ==========================================

# 1. 账号与密码（必填）
# 支持单个账号，或多个账号用 # 分隔（例如：13800000000#abc@qq.com）
USER=13800000000
PWD=your_password

# 2. 步数随机范围设置（选填，默认 18000 ~ 25000）
# 该范围为北京时间22点达到的每日目标；实际执行时按 当前时间/22点 线性缩小随机范围
# 同一天内多次执行步数只增不减，模拟真实走路累积，跨天自动重置
MIN_STEP=18000
MAX_STEP=25000

# 3. 本地加密密钥（选填）
# 建议配置 16 位字符串密钥，用于保存和加密 Token 及已绑定设备 ID，加速后续登录
AES_KEY=1234567890123456

# 4. 多账号执行配置（选填）
SLEEP_GAP=5
USE_CONCURRENT=False

# 5. 推送服务通知配置（选填）
# PushPlus 推送配置
PUSH_PLUS_TOKEN=
PUSH_PLUS_HOUR=
PUSH_PLUS_MAX=30

# 企业微信 Webhook 机器人推送配置
PUSH_WECHAT_WEBHOOK_KEY=

# 钉钉群自定义机器人推送配置
# DINGTALK_WEBHOOK_TOKEN 填机器人 Webhook 地址中的 access_token 参数，也支持直接粘贴完整 Webhook 地址
# 机器人安全设置若使用加签，需要同时配置 DINGTALK_WEBHOOK_SECRET（SEC 开头的密钥）；使用关键词或IP白名单方式则不填
DINGTALK_WEBHOOK_TOKEN=
DINGTALK_WEBHOOK_SECRET=

# Telegram Bot 推送配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 6. JSON 格式全量配置（选填）
# GitHub Actions 环境中使用的 CONFIG 变量范例
# CONFIG='{"USER": "13800000000", "PWD": "your_password", "MIN_STEP": "18000", "MAX_STEP": "25000"}'
